{
  // Type checks the client's JSDoc annotations; nothing is compiled, the browser runs the sources as-is.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src/main/webapp/js/**/*.js"]
}
