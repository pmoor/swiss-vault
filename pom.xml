<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ws.moor.swissvault</groupId>
    <artifactId>swiss-vault</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Swiss Vault</name>
    <url>https://github.com/pmoor/swiss-vault</url>

    <properties>
        <!-- 5.1.0 ships a 34MB appengine-api-1.0-sdk jar, above App Engine's 32MB per-file limit -->
        <appengine.sdk.version>5.0.5</appengine.sdk.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <client.sources>${project.basedir}/src/main/webapp/js</client.sources>
        <client.bundle>${project.build.directory}/client-bundle</client.bundle>
        <!-- port the dev server listens on during integration tests -->
        <it.port>8181</it.port>
        <!-- Chrome used by the browser integration tests -->
        <chrome.path>/usr/bin/google-chrome</chrome.path>
    </properties>

    <build>
        <plugins>
            <!-- the App Engine SDK provides the dev server and deploy staging, see devserver.sh and deploy.sh -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-closure-compiler</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.google.javascript</groupId>
                                    <artifactId>closure-compiler</artifactId>
                                    <version>v20261005</version>
                                    <destFileName>closure-compiler.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>unpack-appengine-sdk</id>
                        <phase>package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.google.appengine</groupId>
                                    <artifactId>appengine-java-sdk</artifactId>
                                    <version>${appengine.sdk.version}</version>
                                    <type>zip</type>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/appengine-java-sdk</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>start-devserver</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/devserver.sh</executable>
                            <arguments>
                                <argument>${it.port}</argument>
                                <argument>${project.build.directory}/devserver-it</argument>
                            </arguments>
                            <!-- keeps running during the integration tests, killed when maven exits -->
                            <async>true</async>
                            <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- bundles and minifies the client's modules into js/app.js (plus a source map) -->
                        <id>bundle-client</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <!-- output paths relative to here, so the source map has no absolute path -->
                            <workingDirectory>${client.bundle}/js</workingDirectory>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/closure-compiler.jar</argument>
                                <!-- SIMPLE only: ADVANCED would rename the fields of the server's JSON -->
                                <argument>--compilation_level=SIMPLE</argument>
                                <argument>--language_in=STABLE</argument>
                                <argument>--language_out=ECMASCRIPT_2021</argument>
                                <argument>--dependency_mode=PRUNE</argument>
                                <argument>--js_module_root=${client.sources}</argument>
                                <argument>--entry_point=main.js</argument>
                                <argument>--js=${client.sources}/**.js</argument>
                                <argument>--js_output_file=app.js</argument>
                                <argument>--create_source_map=app.js.map</argument>
                                <argument>--source_map_include_content</argument>
                                <argument>--source_map_location_mapping=${client.sources}/|/js/</argument>
                                <argument>--output_wrapper=%output%&#10;//# sourceMappingURL=app.js.map</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <!-- ship the bundle instead of the individual modules -->
                    <warSourceExcludes>js/**</warSourceExcludes>
                    <webResources>
                        <resource>
                            <directory>${client.bundle}</directory>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <excludedGroups>ws.moor.categories.Integration</excludedGroups>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <groups>ws.moor.categories.Integration</groups>
                    <systemPropertyVariables>
                        <it.port>${it.port}</it.port>
                        <chrome.path>${chrome.path}</chrome.path>
                    </systemPropertyVariables>
                    <includes>
                      <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.appengine</groupId>
            <artifactId>appengine-api-stubs</artifactId>
            <version>${appengine.sdk.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.appengine</groupId>
            <artifactId>appengine-testing</artifactId>
            <version>${appengine.sdk.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.appengine</groupId>
            <artifactId>appengine-api-1.0-sdk</artifactId>
            <version>${appengine.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>

        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
            <version>6.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.15.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.inject.extensions</groupId>
            <artifactId>guice-servlet</artifactId>
            <version>6.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.64.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <version>1.4.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
